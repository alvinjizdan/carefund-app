# ==============================================================================
# CareFund Backend — Production Environment Template
# ==============================================================================
# File: .env.production.example
# Security & Operational Guidelines:
#   1. NEVER commit actual populated secret values or production .env files.
#   2. Use this template as a configuration contract for production deployment.
#   3. Populate variables via your deployment environment or secrets manager.
#   4. Development/test fallback credentials (e.g. default passwords) are rejected
#      in production by application config validation.
#   5. All inter-service traffic stays on the internal Docker bridge network.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN & EDGE REVERSE PROXY (Caddy)
# ------------------------------------------------------------------------------
# DOMAIN: Fully Qualified Domain Name (FQDN) for public HTTPS ingress.
# Consumed by Caddy (deploy/caddy/Caddyfile) for Automatic HTTPS and ACME TLS.
# Prerequisites: DNS A/AAAA records must point to the deployment host; ports 80/443 open.
# Do NOT use localhost or an unconfigured domain.
DOMAIN=<production-domain>

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & LOGGING
# ------------------------------------------------------------------------------
# ENV: Runtime environment mode (production | development | test).
# Enforces production security checks (rejects default DB passwords, requires CORS, etc.).
ENV=production

# PORT: Internal HTTP port for CareFund API server.
# Default: 8080 (exposed on internal Docker network, reverse-proxied by Caddy).
PORT=8080

# LOG_FORMAT: Structured logging format (json | logfmt).
# Safe production default: json (emits single-line JSON to stdout for container log drivers).
# Application code ensures sensitive credentials, tokens, and passwords are redacted.
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 3. EXTERNAL MANAGED POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Production uses an external/managed PostgreSQL instance (e.g. AWS RDS, DigitalOcean, Neon).
# Database provider must support encrypted transport (TLS).
# Consumed by API, Worker, and Migration services.

# DB_HOST: Managed database hostname or private network IP.
# REQUIRED NON-SECRET.
DB_HOST=<managed-postgres-host>

# DB_PORT: PostgreSQL listening port.
# OPTIONAL. Default: 5432.
DB_PORT=5432

# DB_USER: PostgreSQL database username.
# REQUIRED NON-SECRET.
DB_USER=<production-db-user>

# DB_PASSWORD: PostgreSQL database password.
# REQUIRED SECRET. Inject via deployment secret management. Do not commit actual value.
# Config validation fails fast if empty in production; fallback passwords are forbidden.
DB_PASSWORD=<set-production-database-password>

# DB_NAME: Production database name.
# REQUIRED NON-SECRET.
DB_NAME=<production-db-name>

# DB_SSLMODE: TLS connection mode to PostgreSQL.
# Safe production default: require.
# Permitted production modes: require, verify-ca, verify-full.
# DB_SSLMODE=disable or empty string is strictly REJECTED by application config in production.
# Specific certificate-verification strategies (verify-ca, verify-full) can be refined after provider selection.
DB_SSLMODE=require

# Database Connection Pool Tuning
# Baseline: 25 max open, 10 max idle connections per service.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# PostgreSQL Server-Side Query & Lock Timeouts
# Protects the managed database against runaway queries and transaction deadlocks.
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TRANSACTION_TIMEOUT=10s

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic secret for signing and verifying HMAC-SHA256 JWT tokens.
# REQUIRED SECRET. Inject via deployment secret management. Do not commit actual value.
# Application validation enforces that this value is non-empty in production.
# Generating at least 256 bits (32 bytes) of cryptographically secure random characters
# (e.g. `openssl rand -base64 32`) is an operational security recommendation,
# not an application validation constraint.
JWT_SECRET=<generate-a-random-production-secret>

# JWT_ACCESS_TTL: Validity duration for user access tokens.
# OPTIONAL. Default: 15m.
JWT_ACCESS_TTL=15m

# ------------------------------------------------------------------------------
# 5. MIDTRANS PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Production credentials from your Midtrans Production Dashboard (https://dashboard.midtrans.com).
# Real payments require production credentials; do not use sandbox credentials in production.

# MIDTRANS_SERVER_KEY: Midtrans Production Server Key.
# REQUIRED SECRET. Used for Snap transaction tokens, Core API status checks, and refunds.
# Inject via deployment secret management. Do not commit actual value.
MIDTRANS_SERVER_KEY=<set-production-midtrans-server-key>

# MIDTRANS_CLIENT_KEY: Midtrans Production Client Key.
# REQUIRED NON-SECRET. Used by frontend Snap.js client integration.
MIDTRANS_CLIENT_KEY=<set-production-midtrans-client-key>

# MIDTRANS_ENVIRONMENT: Target Midtrans environment (production | sandbox).
# Safe production default: production.
# Application code defaults to 'sandbox' if unset; must be set to 'production' for live payments.
MIDTRANS_ENVIRONMENT=production

# Payment Reconciliation & Outbox TTLs
# PAYMENT_PENDING_TTL: Expiration window before pending donations/payments expire (default: 45m).
# OUTBOX_PROCESSING_TTL: Processing lease duration for asynchronous payment outbox tasks (default: 15m).
PAYMENT_PENDING_TTL=45m
OUTBOX_PROCESSING_TTL=15m

# ------------------------------------------------------------------------------
# 6. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins.
# REQUIRED NON-SECRET.
# Format: https://example.com,https://app.example.com (exact protocol + domain, comma-delimited).
# Config validation fails fast if empty or 'http://localhost:3000' in production.
# Wildcard '*' is strongly discouraged for production credentials/cookies.
CORS_ALLOWED_ORIGINS=<https://frontend-production-domain>

# ------------------------------------------------------------------------------
# 7. REVERSE PROXY & CLIENT IP EXTRACTION
# ------------------------------------------------------------------------------
# TRUSTED_PROXY_CIDRS: Comma-separated CIDR list of trusted upstream reverse proxies.
# If empty: API uses direct connection RemoteAddr and ignores X-Forwarded-For / X-Real-IP headers.
# If set: API extracts client IP from X-Forwarded-For when connection originates from these CIDRs.
# IMPORTANT:
#   - Set this ONLY to the specific CIDR or container IP of the Caddy reverse-proxy network.
#   - Do NOT use broad RFC 1918 blocks (e.g. 172.16.0.0/12 was rejected as overly broad).
#   - Example for dedicated Docker bridge subnet: 172.28.0.0/24 or specific Caddy container IP.
TRUSTED_PROXY_CIDRS=

# ------------------------------------------------------------------------------
# 8. INTERNAL OBSERVABILITY & METRICS
# ------------------------------------------------------------------------------
# Metrics are bound to internal container interfaces (0.0.0.0) for internal Docker network
# scraping by Prometheus. These ports are NEVER published to the host or public internet.

# METRICS_HOST: API metrics bind address (internal Docker network: 0.0.0.0).
METRICS_HOST=0.0.0.0
# METRICS_PORT: Dedicated internal port for API Prometheus metrics.
METRICS_PORT=9090

# WORKER_METRICS_HOST: Worker metrics bind address (internal Docker network: 0.0.0.0).
WORKER_METRICS_HOST=0.0.0.0
# WORKER_METRICS_PORT: Dedicated internal port for Worker Prometheus metrics.
WORKER_METRICS_PORT=9091

# WORKER_RUN_ONCE: Optional worker execution mode (default: false / unset = continuous daemon).
# Set to 'true' only if executing a single batch reconciliation pass in an ephemeral container.
# WORKER_RUN_ONCE=false
